# Copy this file to .env and fill in real values from your Neon project
# dashboard (neon.tech -> your project -> Connection Details). .env is
# gitignored; this file is the checked-in template and should never hold
# real credentials.
#
# Not used by anything yet -- prisma/schema.prisma references DATABASE_URL,
# but Prisma itself isn't installed in this project (see the comment at
# the top of that file). These variables exist so the values are ready to
# go the moment that changes; until then, nothing reads them.
#
# Names below match what Neon's dashboard actually generates (confirmed
# against a real project), not a guessed convention -- an earlier draft of
# this file used DIRECT_URL, which isn't what Neon calls it.

# Pooled connection (through Neon's PgBouncer) -- what a running app
# should use for normal queries. Hostname contains "-pooler".
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<database>?channel_binding=require&sslmode=require"

# Unpooled connection -- required for `prisma migrate`. Running migrations
# through a pooled/PgBouncer connection is unsupported by Prisma. Same
# hostname without "-pooler".
DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<database>?sslmode=require"

# Neon also offers these as separate parameters, for building your own
# connection string rather than using the two above directly.
PGHOST="<endpoint>-pooler.<region>.aws.neon.tech"
PGHOST_UNPOOLED="<endpoint>.<region>.aws.neon.tech"
PGUSER="<user>"
PGDATABASE="<database>"
PGPASSWORD="<password>"
