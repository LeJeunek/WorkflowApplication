// Backs the Express API in server/ (see server/routes/workflows.ts) --
// Prisma Client is Node-only, so it runs there, not in the Vite client
// bundle. The client talks to it over HTTP via
// src/features/workflow/state/remoteWorkflows.ts.
//
// `nodes`/`edges` are stored as JSON, mirroring the client's `Workflow`
// domain type (src/features/workflow/types.ts) exactly -- a normalized
// relational schema (separate WorkflowNode/WorkflowEdge tables) is a
// bigger, separate design decision this file deliberately doesn't make.
//
// `url` uses the pooled connection (through Neon's PgBouncer) for normal
// queries; `directUrl` uses the unpooled one specifically for `prisma
// migrate`, which PgBouncer's pooling doesn't reliably support. Both come
// from .env -- see .env.example for where to find them on a Neon project's
// dashboard.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Workflow {
  id          String   @id @default(uuid())
  name        String
  description String?
  nodes       Json
  edges       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
