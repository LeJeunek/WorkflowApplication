// Not yet wired to a running app. This project currently has no server --
// it's a Vite SPA that persists to the browser's localStorage (see
// src/features/workflow/state/persistence.ts). This schema exists so a
// future Postgres-backed persistence layer has a concrete target to build
// against, rather than inventing the shape from scratch at that point.
//
// `nodes`/`edges` are stored as JSON, mirroring the client's `Workflow`
// domain type (src/features/workflow/types.ts) exactly -- a normalized
// relational schema (separate WorkflowNode/WorkflowEdge tables) is a
// bigger, separate design decision this file deliberately doesn't make.
//
// To activate:
//   npm install -D prisma
//   npm install @prisma/client
//   npx prisma migrate dev --name init
// (requires DATABASE_URL, and for running migrations specifically
// DATABASE_URL_UNPOOLED too -- see .env.example, confirmed against a real
// Neon project's actual dashboard output -- plus a server to run Prisma
// Client from; it cannot run in the browser bundle.)
//
// NOTE: Prisma isn't installed in this project, so the exact mechanics
// below haven't been verified against a real CLI. This project's own
// editor tooling flags `url`/`directUrl` in `datasource` as moved to a
// separate prisma.config.ts in newer Prisma versions -- if that's still
// true when this is actually activated, `npx prisma init` (run against
// whatever version gets installed then) will scaffold the current
// convention correctly; trust that output over this comment.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workflow {
  id          String   @id @default(uuid())
  name        String
  description String?
  nodes       Json
  edges       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
